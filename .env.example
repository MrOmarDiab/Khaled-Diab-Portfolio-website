# ===============================================
# CONTACT FORM SETUP - Web3Forms
# ===============================================
# 
# To enable the contact form to send emails:
#
# 1. Visit: https://web3forms.com
# 2. Enter your email (mz3construction@gmail.com)
# 3. Check your inbox for the Access Key
# 4. Open: src/components/ContactSection.tsx
# 5. Find line 33: const accessKey = "YOUR_ACCESS_KEY_HERE";
# 6. Replace YOUR_ACCESS_KEY_HERE with your actual key
# 7. Save the file
#
# Example:
# const accessKey = "a1b2c3d4-5678-90ef-ghij-klmnopqrstuv";
#
# The form will then forward all messages to mz3construction@gmail.com
# ===============================================
